APP_ADDR=:8080
APP_ENVIRONMENT=local
APP_API_KEYS=change-me-local-dev-key
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Persistent app data. JSON store keeps MVP dependency-free.
APP_STORE_PATH=./data/store.json
APP_MEDIA_ROOT=./data/media
# Flutter Web build served by the Go backend at the same IP and port.
APP_WEB_ROOT=./mobile/build/web
APP_PUBLIC_MEDIA_BASE_URL=

# YouTube/SoundCloud search, playback and download all run through yt-dlp and are
# OFF by default so a public deployment stays safe. For personal self-hosted use
# set this to true — otherwise /v1/providers reports youtube_stream and
# soundcloud_stream as enabled=false and search has no active music source.
APP_ENABLE_RISKY_EXTRACTORS=false
# Use an absolute path if yt-dlp is not on the PATH of the user running the server
# (e.g. ~/.local/bin/yt-dlp installed via pip). Check with: which yt-dlp
APP_YT_DLP_BINARY=yt-dlp
# JavaScript runtime yt-dlp may use. It enables only deno by default and warns on
# every run when none is available, and some SoundCloud HLS and YouTube formats
# cannot be extracted without one. An unavailable name only costs a warning.
# Set empty for a yt-dlp older than 2025.09 that does not know --js-runtimes.
APP_YTDLP_JS_RUNTIMES=node
APP_EXTRACTOR_TIMEOUT_SECONDS=30
APP_DOWNLOAD_TIMEOUT_SECONDS=600
# Deadline for the ffmpeg HLS remux that SoundCloud playback needs. The listener
# waits on this one, so it is far shorter than a background download.
APP_HLS_REMUX_TIMEOUT_SECONDS=120

# Optional outbound proxy used by both yt-dlp and the backend stream/artwork proxy.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=127.0.0.1,localhost

# Optional future official integrations.
APP_YOUTUBE_API_KEY=
APP_SOUNDCLOUD_CLIENT_ID=
APP_NAVIDROME_BASE_URL=
APP_NAVIDROME_USERNAME=
APP_NAVIDROME_TOKEN=

# First-run owner registration happens in the UI/API and is stored in APP_STORE_PATH.
# APP_ADMIN_PASSWORD / APP_TOTP_SECRET are intentionally not used for setup.
# Protected endpoints still accept X-API-Key as a service-token fallback.
APP_SESSION_TTL_HOURS=72
# Set true behind HTTPS (production).
APP_SECURE_COOKIES=false
